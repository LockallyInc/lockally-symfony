{
  "name": "lockally/symfony-mailer",
  "description": "Official Lockally Mailer transport for Symfony — send transactional email via Lockally with MAILER_DSN=lockally+api://KEY@default.",
  "keywords": ["lockally", "symfony", "mailer", "transport", "email", "transactional"],
  "homepage": "https://github.com/lockallyinc/lockally-symfony",
  "license": "MIT",
  "authors": [{ "name": "Lockally", "email": "support@lockally.com", "homepage": "https://lockally.com" }],
  "require": {
    "php": "^8.1",
    "lockally/sdk": "^0.1",
    "symfony/mailer": "^6.2 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": { "Lockally\\Symfony\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Lockally\\Symfony\\Tests\\": "tests/" }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": { "sort-packages": true }
}
